# Tigris credentials (boto3/s3fs read these automatically)
AWS_ACCESS_KEY_ID=tid_YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=tsec_YOUR_SECRET_ACCESS_KEY
AWS_REGION=auto
AWS_ENDPOINT_URL=https://t3.storage.dev

# LLM + embedding models (OpenAI by default)
LLM_API_KEY=sk-your-openai-api-key
LLM_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small

# Store data on Tigris instead of local disk
STORAGE_BACKEND=s3
STORAGE_BUCKET_NAME=<bucket>
DATA_ROOT_DIRECTORY=s3://<bucket>/cognee/data
# SYSTEM_ROOT_DIRECTORY: leave unset to auto-derive a local path (Windows),
# or set s3://<bucket>/cognee/system for fully single-bucket mode (Linux/WSL)
