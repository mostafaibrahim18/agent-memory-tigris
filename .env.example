# ---- OpenAI (Cognee embeddings + chat) ----
LLM_API_KEY=sk-your-openai-key-here
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# ---- Tigris (S3-compatible) ----
STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=auto
AWS_ENDPOINT_URL=https://t3.storage.dev

# ---- Bucket + Cognee storage roots ----
STORAGE_BUCKET_NAME=agent-memory-demo
DATA_ROOT_DIRECTORY=s3://agent-memory-demo/cognee/data
